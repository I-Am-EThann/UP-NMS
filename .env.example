# Copy this file to ".env" (no ".example") and fill in real values.
# ".env" is git-ignored — never commit it. This file (.env.example) IS meant
# to be committed, so it must only ever contain placeholders, never real
# secrets.

# Generate strong random secrets with: openssl rand -base64 32
POSTGRES_PASSWORD=changeme-generate-a-real-secret
INFLUXDB_INIT_PASSWORD=changeme-generate-a-real-secret
INFLUX_TOKEN=changeme-generate-a-real-secret
MINIO_ACCESS_KEY=changeme-generate-a-real-value
MINIO_SECRET_KEY=changeme-generate-a-real-secret
JWT_SECRET=changeme-generate-a-real-secret-at-least-32-chars

# Admin login created by `npm run db:seed` — change before deploying anywhere
# real. SEED_ADMIN_USERNAME is optional, defaults to "admin" if omitted.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=changeme

# --- URLs — adjust for local dev vs. your real server ---
# Local dev on your own machine (default):
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_WS_URL=http://localhost:3001
MINIO_PUBLIC_ENDPOINT=localhost

# Deploying to a real server instead? Replace "localhost" above with the
# server's real IP/domain in all four, e.g.:
#   CORS_ORIGIN=http://10.204.10.209:3000
#   NEXT_PUBLIC_API_URL=http://10.204.10.209:3001/api
#   NEXT_PUBLIC_WS_URL=http://10.204.10.209:3001
#   MINIO_PUBLIC_ENDPOINT=10.204.10.209

# "mock" = simulated device data, no real hardware needed
# "real" = poll actual devices over SNMP — see ARUBA-6200F-TESTING-GUIDE.md
SNMP_PROVIDER=mock
