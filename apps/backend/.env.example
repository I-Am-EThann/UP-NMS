# Copy to .env.local for local development (docker-compose already sets these for the container).

NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Auth ---
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=8h

# --- Seed script (npm run db:seed) ---
# Creates ONLY this one admin login — no sample zones/devices/alerts.
# Change these before seeding a real deployment.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=phayao2569

# --- PostgreSQL (Prisma) ---
DATABASE_URL=postgresql://upnms:upnms@localhost:5432/upnms

# --- InfluxDB (device metrics time-series) ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=
INFLUX_ORG=upnms
INFLUX_BUCKET=device_metrics

# --- MinIO (device images) ---
# "localhost" is correct here because this .env.example is for running the
# backend directly on the host (npm run dev:backend), not inside Docker —
# only the infra services (postgres/influxdb/minio) run in containers, with
# their ports published to localhost. If you containerize the backend too,
# see docker-compose.yml's MINIO_ENDPOINT/MINIO_PUBLIC_ENDPOINT split
# instead (Docker containers can't reach each other via "localhost").
MINIO_ENDPOINT=localhost
MINIO_PUBLIC_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=upnms
MINIO_SECRET_KEY=upnms-secret
MINIO_BUCKET=device-images

# --- SNMP ---
# "mock"  = simulated device data, no real hardware needed (default, matches
#           the seed data the frontend already ships with)
# "real"  = poll actual devices over SNMP
SNMP_PROVIDER=mock
SNMP_COMMUNITY=public
SNMP_POLL_INTERVAL_MS=300000
# ^ 300000ms = 5 minutes — how often every Switch/AP is polled for fresh data
